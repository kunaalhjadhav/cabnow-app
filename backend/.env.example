# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ---- Database ----
DATABASE_URL=postgresql://cab_admin:changeme@localhost:5432/cab_platform?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ---- SMS / OTP provider ----
# Set SMS_PROVIDER to "twilio" or "msg91". Only fill in the block you use.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=CABAPP
MSG91_OTP_TEMPLATE_ID=your-msg91-template-id

# ---- Maps ----
# Google Maps (or swap for another provider behind the same interface)
MAPS_PROVIDER=google
GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key

# ---- Payments ----
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---- Push notifications (optional) ----
FCM_SERVER_KEY=your-fcm-server-key
